# ── Amazon Bedrock ────────────────────────────────────────────────────────────
# Region where Nova Pro is enabled for your account
AWS_REGION=ap-south-1

# Bedrock long API key (bearer token). boto3 picks this up automatically for the
# bedrock-runtime client. Paste your key as the value below — do NOT commit the real .env.
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key-here

# Model id. ap-south-1 requires the APAC cross-region inference profile for Nova Pro
# (plain "amazon.nova-pro-v1:0" is not invokable on-demand in ap-south-1).
BEDROCK_MODEL_ID=apac.amazon.nova-pro-v1:0

# ── Google Places (hospital search) ───────────────────────────────────────────
GOOGLE_PLACES_API_KEY=your-google-places-key-here

# ── Twilio (outbound AI voice call to relatives) ─────────────────────────────
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890

# ── Server ────────────────────────────────────────────────────────────────────
AGENT_PORT=8100
